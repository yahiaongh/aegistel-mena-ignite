# Example environment variables for local development
# Replace values with your project-specific configuration; do NOT commit secrets.

# Project
PROJECT_NAME=
API_V1_STR=/api/v1

# Nokia CAMARA (NOKIA NaC) SDK
NOKIA_NAC_API_KEY=
NOKIA_NAC_HOST=network-as-code.nokia.rapidapi.com
NOKIA_CAMARA_BASE_URL=https://network-as-code.p-eu.rapidapi.com/passthrough/camara/v1

# LLM / provider keys
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# Model defaults (Groq: llama-3.3-70b / llama-3.1-8b decommissioned 2026-08-16,
# replaced by GPT-OSS 120B / GPT-OSS 20B)
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest

# Other service keys (optional)
DEEPGRAM_API_KEY=
QDRANT_API_KEY=
QDRANT_URL=

# App runtime
APP_ENV=development
PORT=8000

# Frontend integration (used by README/dev instructions)
# Origin allowed for browser CORS
FRONTEND_ORIGIN=http://localhost:3000
# Base URL the frontend uses to call the API (used by Next.js runtime)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
