# AegisTel — environment template
# Copy this file to `.env` (repo root) and fill in your own keys.
# Real values are never committed; this file contains key names + placeholders only.

# --- LLM / model chain (fallback: Groq -> OpenRouter -> Gemini) ---------------
GOOGLE_API_KEY=
GROQ_API_KEY=
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
DEEPGRAM_API_KEY=

# --- Nokia Network-as-Code (CAMARA) ---
NOKIA_NAC_API_KEY=
NOKIA_NAC_HOST=network-as-code.nokia.rapidapi.com
NOKIA_CAMARA_BASE_URL=https://network-as-code.p-eu.rapidapi.com/passthrough/camara/v1

# --- Operator / admin auth ---
# Bearer / X-Admin-Token / ?token= for operator-only endpoints (history,
# memory wipe, provider probe, feedback readback, QoD provisioning).
AEGISTEL_ADMIN_KEY=

# --- Tenancy ---
# Comma-separated "tenant_id=api_key" pairs, e.g. bank-a=k1,bank-b=k2.
# Client tenant is derived server-side from the credential, never from the body.
AEGISTEL_TENANT_API_KEYS=
AEGISTEL_DEFAULT_TENANT=demo
AEGISTEL_ALLOW_ANON_AUDIT=true

# --- QoD provisioning policy ---
# Audits surface qod_recommended only; a session is created via
# POST /api/v1/audit/qod/provision only when this flag is enabled.
AEGISTEL_QOD_POLICY_ENABLED=true
AEGISTEL_QOD_SERVICE_IP=233.252.0.2

# --- Rate limiting ---
AEGISTEL_API_RATE_LIMIT_PER_MIN=120

# --- Memory ---
# 1 = mirror incidents + feedback to Qdrant for durable cross-restart history.
AEGISTEL_LIVE_MEMORY=0
AEGISTEL_MEMORY_PATH=backend/data/local_memory.jsonl

# --- Qdrant (optional, used when AEGISTEL_LIVE_MEMORY=1) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Runtime ---
APP_ENV=development
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LITELLM_DROP_PARAMS=true